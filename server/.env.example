# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Porta do servidor (serve o site e a API no mesmo endereço)
PORT=3000

# Endereço público do site, com https. Usado para montar a URL do postback da PixGate
# (a PixGate só envia postback para URL pública HTTPS; em localhost o pagamento é confirmado pela consulta).
URL_PUBLICA=https://devocionalfilhodelagrimas.com.br

# Produto
PRODUTO_NOME=O Filho de Tantas Lágrimas
PIX_VALOR=37.00
# Quanto tempo o código fica na tela antes de pedir um novo (só visual; a PixGate não informa validade)
PIX_EXPIRA_MINUTOS=30

# Provedor Pix: pixgate | mock
PIX_PROVEDOR=pixgate

# --- PixGate (https://app.pixgateip.com -> Integrações -> API Key) ---
PIXGATE_API_KEY=
# Identificador da conta/instância na PixGate (só referência; a API usa a chave acima)
PIXGATE_CLIENT_ID=

# --- mock (testes locais, sem banco de verdade; use PIX_PROVEDOR=mock) ---
# Segundos até o mock marcar o Pix como pago sozinho. 0 = só paga pela rota POST /api/pix/mock/pagar/:id
MOCK_PAGAR_EM_SEGUNDOS=15

# --- Entrega ---
# Quando o Pix cai, o servidor envia o pedido (JSON) para este endereço (ex.: webhook do n8n que manda o e-mail e o WhatsApp)
ENTREGA_WEBHOOK_URL=
# Segredo enviado no cabeçalho X-Entrega-Token para o n8n conferir que foi o nosso servidor
ENTREGA_TOKEN=

# Segredo para ver a lista de pedidos em GET /api/pedidos?token=...
ADMIN_TOKEN=
